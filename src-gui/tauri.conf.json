{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Testhub Doctor",
  "version": "1.0.0",
  "identifier": "de.gematik.testhub.doctor",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Testhub Doctor",
        "width": 1000,
        "height": 760,
        "minWidth": 780,
        "minHeight": 600,
        "backgroundColor": "#101820"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
